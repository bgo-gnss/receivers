#!/usr/bin/env bash
# ntrcaster-sourcetable — install the NTRIP sourcetable on ntrcaster.vedur.is
#
# Runs ON ntrcaster (gpscoll02) as gpsops, installed at ~gpsops/bin/. It is the
# FORCED COMMAND of rek-d01's delivery key, so that key can do nothing else:
#
#   command="/home/gpsops/bin/ntrcaster-sourcetable",no-pty,no-port-forwarding,
#   no-agent-forwarding,no-X11-forwarding,from="<rek-d01 IP>" ssh-ed25519 AAAA… rek-d01-sourcetable
#
# Verbs (taken from $SSH_ORIGINAL_COMMAND, or $1 when run by hand):
#   status    print "sha256 <file> rehashed <sha|none> str <n>"
#   status    also prints the sha the caster last confirmed rehashing
#   install   read a candidate sourcetable on stdin, validate, back up, install, rehash
#   rehash    rehash the file already on disk (retry of a failed/pending rehash)
#
# Source of truth: gps-config-data/ntrcaster/sourcetable.dat (generated by
# `tosGPS sourcetable`); delivered by receivers' push-ntrcaster-sourcetable.sh.
#
# Caster behaviour this relies on (BKG NtripCaster 2.0.45 source, sourcetable.c /
# commands.c / main.c):
#   - the file is read at startup and on `rehash` only — SIGHUP re-reads
#     ntripcaster.conf and log files but NOT the sourcetable;
#   - rehash merges by mountpoint: changed lines take effect at once, a NEW line
#     for a source that is already connected stays hidden until that source
#     reconnects (its show flag is only set on connect), and a line removed
#     from the file stays loaded until a restart;
#   - STR lines whose mountpoint is not fed are never served.
#
# Writes: the file in place (gpsops may write it but not its directory, so no
# atomic rename), backups + a log under ~/sourcetable/. Debian 8 / bash 4.3 —
# keep this script free of newer features.

set -euo pipefail

# Overridable for a dry test against a copy. A forced command does not take
# the ssh client's environment, so the delivery key cannot redirect these.
LIVE=${NTRCASTER_SOURCETABLE:-/etc/ntripcaster/sourcetable.dat}
STATE=${NTRCASTER_STATE:-$HOME/sourcetable}
BACKUPS=$STATE/backup
LOG=$STATE/install.log
# user:password, mode 600: the caster user gpsops with its users.aut password.
# rehash is an oper command, checked against /oper:imo → imo:gpsops → users.aut;
# admin_password/oper_password in ntripcaster.conf are telnet-console only (401).
ADMIN_CRED=${NTRCASTER_ADMIN_CRED:-$HOME/.config/ntrcaster/admin.cred}
REHASHED=$STATE/rehashed.sha
CASTER_LOG_DIR=${NTRCASTER_LOG_DIR:-/var/log/ntripcaster}
CASTER=http://127.0.0.1:2101
MAX_BYTES=262144
KEEP_BACKUPS=30

mkdir -p "$BACKUPS"

log() { echo "$(date -u +%FT%TZ) $*" >> "$LOG"; echo "$*"; }
die() { log "REFUSED: $*"; exit 1; }

str_count() { grep -c '^STR;' "$1" || true; }

live_sha() { sha256sum < "$LIVE" | cut -d' ' -f1; }

# "rehashed" is the sha of the file the caster last CONFIRMED loading — not
# merely the file on disk. The pusher compares both, so a failed or pending
# rehash (no credential yet) is retried every tick instead of looking done.
status() {
    local rehashed=none
    [ -s "$REHASHED" ] && rehashed=$(cat "$REHASHED")
    echo "sha256 $(live_sha) rehashed $rehashed str $(str_count "$LIVE")"
}

validate() {
    local f=$1 n_str n_live bad dup
    [ -s "$f" ] || die "empty input"
    [ "$(stat -c %s "$f")" -le "$MAX_BYTES" ] || die "larger than $MAX_BYTES bytes"
    if LC_ALL=C grep -q $'\r' "$f"; then die "CR line endings"; fi
    # The live 2021 file has Latin-1 names (Grímsvötn); the generator writes
    # ASCII (Grimsvotn), which every NTRIP client parses the same way.
    if LC_ALL=C grep -q -P '[^\x20-\x7e]' "$f"; then die "non-ASCII or control bytes"; fi
    head -1 "$f" | grep -q '^CAS;' || die "first line is not a CAS record"
    grep -q '^NET;' "$f" || die "no NET record"
    bad=$(grep -v -E '^(CAS|NET|STR);' "$f" | head -1 || true)
    [ -z "$bad" ] || die "unknown record type: ${bad:0:60}"
    # STR: 18 fields (19 with the optional misc field); mountpoint is [A-Za-z0-9_]+
    bad=$(awk -F';' '/^STR;/ && (NF < 18 || NF > 19 || $2 !~ /^[A-Za-z0-9_]+$/) {print $2; exit}' "$f")
    [ -z "$bad" ] || die "malformed STR line for mountpoint '$bad'"
    dup=$(awk -F';' '/^STR;/ {print $2}' "$f" | sort | uniq -d | head -1)
    [ -z "$dup" ] || die "duplicate mountpoint $dup"
    # The generator never drops lines; a large shrink means a truncated or
    # wrong file, not an edit. Removal is a deliberate hand step (and a restart).
    n_str=$(str_count "$f")
    n_live=$(str_count "$LIVE")
    [ "$n_str" -ge $(( n_live * 8 / 10 )) ] || die "STR count $n_live -> $n_str (shrinks > 20 %)"
}

rehash() {
    local sha logf before
    sha=$(live_sha)
    if [ ! -r "$ADMIN_CRED" ]; then
        log "rehash PENDING: no $ADMIN_CRED — caster still serves the previous table"
        return 1
    fi
    # Proof of the rehash is the caster's own "Rehashing sourcetable" log line
    # (commands.c:com_rehash), looked for only in what was written after the
    # request. /admin answers a bad login with 401, which -f also catches.
    logf=$CASTER_LOG_DIR/ntripcaster-$(date +%y%m%d).log
    before=$(stat -c %s "$logf" 2>/dev/null || echo 0)
    # The credential goes to curl on stdin as a config line, never on argv.
    if ! printf 'user = "%s"\n' "$(head -1 "$ADMIN_CRED")" \
        | curl -sS -f -o /dev/null --max-time 20 -K - "$CASTER/admin?mode=rehash"; then
        log "ERROR: rehash request failed — caster still serves the previous table"
        return 1
    fi
    sleep 1
    # A day rollover between the two reads is reported as unconfirmed and simply
    # retried on the next tick: a repeated rehash is harmless.
    if tail -c +$(( before + 1 )) "$logf" 2>/dev/null | grep -q "Rehashing sourcetable"; then
        echo "$sha" > "$REHASHED"
        log "rehash OK ($sha)"
    else
        log "ERROR: rehash not confirmed in $logf — will retry"
        return 1
    fi
}

install_table() {
    local stamp
    # Global, not local: the EXIT trap runs after this function has returned.
    INCOMING=$(mktemp "$STATE/incoming.XXXXXX")
    trap 'rm -f "$INCOMING"' EXIT
    local tmp=$INCOMING
    head -c $(( MAX_BYTES + 1 )) > "$tmp"
    validate "$tmp"
    if cmp -s "$tmp" "$LIVE"; then
        echo "unchanged"
        return 0
    fi  # (a pending rehash of an unchanged file is the `rehash` verb's job)
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    cp -p "$LIVE" "$BACKUPS/sourcetable.dat.$stamp"
    # Prune old backups, newest first.
    ls -1t "$BACKUPS"/sourcetable.dat.* 2>/dev/null | tail -n +$(( KEEP_BACKUPS + 1 )) \
        | xargs -r rm -f
    cat "$tmp" > "$LIVE"
    log "installed $(str_count "$LIVE") STR (was $(str_count "$BACKUPS/sourcetable.dat.$stamp")), backup $stamp"
    rehash
}

verb=${SSH_ORIGINAL_COMMAND:-${1:-}}
case "$verb" in
    status) status ;;
    install) install_table ;;
    rehash) rehash ;;
    *) echo "usage: status | install < sourcetable.dat | rehash" >&2; exit 2 ;;
esac
