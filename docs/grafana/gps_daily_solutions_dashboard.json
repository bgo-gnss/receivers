    {
      "id": 6,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Legend** &nbsp; <span style=\"background:#37872D;color:#fff;padding:1px 6px;border-radius:3px\">✓</span> available / verified &nbsp; <span style=\"background:#5A7D8C;color:#fff;padding:1px 6px;border-radius:3px\">❄</span> available / frozen &nbsp; <span style=\"background:#8AB8FF;color:#fff;padding:1px 6px;border-radius:3px\">…</span> pending / before deadline &nbsp; <span style=\"background:#3274D9;color:#fff;padding:1px 6px;border-radius:3px\">↻</span> pending / awaiting recheck &nbsp; <span style=\"background:#FF9830;color:#fff;padding:1px 6px;border-radius:3px\">late</span> overdue / no completion record &nbsp; <span style=\"background:#E02F44;color:#fff;padding:1px 6px;border-radius:3px\">✗</span> overdue / absent after completion &nbsp; <span style=\"background:#8F1A2A;color:#fff;padding:1px 6px;border-radius:3px\">rej</span> overdue / producer &nbsp; <span style=\"background:#A352CC;color:#fff;padding:1px 6px;border-radius:3px\">inv</span> invalid &nbsp; <span style=\"background:#D0D0D0;color:#fff;padding:1px 6px;border-radius:3px\">–</span> not expected &nbsp; <span style=\"background:#4D4D4D;color:#fff;padding:1px 6px;border-radius:3px\">?</span> unknown<br/>States come from `solution_day_grid` only (plan §3). Click a station for its data-delivery and receiver dashboards."
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Station × UTC day",
      "description": "One cell per station and UTC day. Frozen = valid when last verified, now older than the 45-day re-check window. 'late' = no completion record; '✗' = absent after the producer finished (confirmed).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gps_health"
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gps_health"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH g AS (SELECT * FROM solution_day_grid('${stream}',\n        ($__timeFrom() AT TIME ZONE 'UTC')::date,\n        ($__timeTo() AT TIME ZONE 'UTC')::date,\n        now()) WHERE station IN (${station:sqlstring}))\nSELECT station, to_char(day, 'YYYY-MM-DD') AS day,\n       CASE\n      WHEN state = 'available' AND reason = 'verified' THEN 1\n      WHEN state = 'available' THEN 2\n      WHEN state = 'pending' AND reason = 'before_deadline' THEN 3\n      WHEN state = 'pending' THEN 4\n      WHEN state = 'overdue' AND reason = 'no_completion_record' THEN 5\n      WHEN state = 'overdue' AND reason = 'absent_after_completion' THEN 6\n      WHEN state = 'overdue' THEN 7\n      WHEN state = 'invalid' THEN 8\n      WHEN state = 'not_expected' THEN 9\n      ELSE 10\n    END AS code\nFROM g\nWHERE '${show}' = 'all' OR station IN (SELECT station FROM g WHERE state NOT IN ('available', 'not_expected') AND reason <> 'before_deadline')\nORDER BY day, station",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "day",
            "rowField": "station",
            "valueField": "code",
            "emptyValue": "null"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\d{4}-(\\d{2})-(\\d{2})$",
            "renamePattern": "$1-$2"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "width": 40,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "inspect": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✓",
                  "color": "#37872D",
                  "index": 0
                },
                "2": {
                  "text": "❄",
                  "color": "#5A7D8C",
                  "index": 1
                },
                "3": {
                  "text": "…",
                  "color": "#8AB8FF",
                  "index": 2
                },
                "4": {
                  "text": "↻",
                  "color": "#3274D9",
                  "index": 3
                },
                "5": {
                  "text": "late",
                  "color": "#FF9830",
                  "index": 4
                },
                "6": {
                  "text": "✗",
                  "color": "#E02F44",
                  "index": 5
                },
                "7": {
                  "text": "rej",
                  "color": "#8F1A2A",
                  "index": 6
                },
                "8": {
                  "text": "inv",
                  "color": "#A352CC",
                  "index": 7
                },
                "9": {
                  "text": "–",
                  "color": "#D0D0D0",
                  "index": 8
                },
                "10": {
                  "text": "?",
                  "color": "#4D4D4D",
                  "index": 9
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 64
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Data delivery (raw / RINEX) for ${__value.raw}",
                    "url": "/d/gps-data-delivery/gps-data-delivery?var-station=${__value.raw}&${__url_time_range}"
                  },
                  {
                    "title": "Receiver health for ${__value.raw}",
                    "url": "/d/gps-station-detail/gps-station-detail?var-station=${__value.raw}"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Station"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "frozenColumns": {
          "left": 1
        }
      }
    },
