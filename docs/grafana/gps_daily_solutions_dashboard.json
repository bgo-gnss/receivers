  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last successful check",
      "description": "Checks older than the stream's freshness TTL turn the 45-day window UNKNOWN.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gps_health"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gps_health"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(checked_at) AS \"last ok\" FROM solution_check_run WHERE stream = '${stream}' AND outcome = 'ok'",
          "refId": "A"
        }
      ]
