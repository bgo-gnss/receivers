          "rawSql": "SELECT count(*) FILTER (WHERE state NOT IN ('available', 'not_expected') AND reason <> 'before_deadline') AS n FROM solution_day_grid('${stream}',\n        ($__timeFrom() AT TIME ZONE 'UTC')::date,\n        ($__timeTo() AT TIME ZONE 'UTC')::date,\n        now()) WHERE station IN (${station:sqlstring})",
          "refId": "A"
